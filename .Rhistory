seuratObj <- RunPCA(object = seuratObj, assay = "HTO", features = VariableFeatures(seuratObj, assay = "HTO"),
npcs = nrow(seuratObj@assays$ADT), ndims.print = 1:5, nfeatures.print = 8,
reduction.name = "HTO_pca",reduction.key = "htoPC_")
