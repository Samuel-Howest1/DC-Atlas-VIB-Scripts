### Increase theta parameter in case of bad overlap!
harmony_embeddings<-RunHarmony(data_mat = pca_embeddings,
meta_data = meta_data,
vars_use = "Condition",  # integrate across your conditions
verbose = TRUE,
theta = 2,
plot_convergence = TRUE, nclust = 50, max.iter = 20, dims.use=1:40)
